# --- Servidor ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Base de datos (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mesa_ayuda
DB_SSL=false

# --- Autenticación ---
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# --- SLA: horas para responder según el nivel ---
SLA_HORAS_ALTO=3
SLA_HORAS_MEDIO=8
SLA_HORAS_BAJO=16

# --- Asistente IA (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Correo (opcional). Sin SMTP_HOST los correos se imprimen en consola ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mesa de Ayuda <no-reply@tuempresa.com>"

# --- Seed (solo desarrollo) ---
SEED_PASSWORD=Cambiar123!
